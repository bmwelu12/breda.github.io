{
  "name": "halo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Halo: self-hosted AI that defends people against AI agents",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:app": "vite --config app/vite.config.ts",
    "dev:ml": "cd ml && python3 -m uvicorn serve.app:app --host 127.0.0.1 --port 8100",
    "build": "vite build --config app/vite.config.ts",
    "build:standalone": "VITE_STANDALONE=1 vite build --config app/vite.config.ts --outDir ../dist-standalone --base ./",
    "start": "tsx server/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^4.29.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
